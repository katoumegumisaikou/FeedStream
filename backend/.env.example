# feed_system 后端环境变量样例
# 复制为 .env 后填入实际值;.env 已在 .gitignore 中,不会入版本控制

# ===== PostgreSQL 连接 =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=feed_system
DB_SSLMODE=disable

# ===== Redis 连接(可选,缺省时 SMS / 登录锁定不可用,鉴权回源 DB) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== HTTP server =====
# 监听地址,默认 :8080
HTTP_ADDR=:8080

# ===== SMS dev 模式 =====
# true:短信验证码会回显到前端响应(仅开发用)
# false:验证码只发到短信网关,不返回给前端(生产务必 false)
SMS_DEV_MODE=true